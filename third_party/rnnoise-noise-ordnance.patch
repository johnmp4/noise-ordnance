+void rnnoise_set_gain_smoothing(DenoiseState *st, float smooth) {
+  if (!st) return;
+  st->gain_smooth = smooth < 0.0f ? 0.0f : (smooth > 0.95f ? 0.95f : smooth);
+}
+
+void rnnoise_set_alpha(DenoiseState *st, float alpha) {
+  if (!st) return;
+  st->alpha = alpha < 0.0f ? 0.0f : (alpha > 0.95f ? 0.95f : alpha);
+}
+
+void rnnoise_set_band_floor(DenoiseState *st, float low_db, float mid_db, float high_db) {
+  if (!st) return;
+  st->floor_low = (low_db <= -79.0f) ? 0.0f : powf(10.0f, low_db / 20.0f);
+  st->floor_mid = (mid_db <= -79.0f) ? 0.0f : powf(10.0f, mid_db / 20.0f);
+  st->floor_high = (high_db <= -79.0f) ? 0.0f : powf(10.0f, high_db / 20.0f);
+}
+
+void rnnoise_set_vad_adapt(DenoiseState *st, float adapt) {
+  if (!st) return;
+  st->vad_adapt = adapt < 0.0f ? 0.0f : (adapt > 1.0f ? 1.0f : adapt);
+}
+
