# Noise Ordnance .gitignore

# DPF build outputs
bin/
*.o
*.d
*.so
*.dll
*.dylib
*.vst3

# Test build artifacts
tests/build/
tests/drills/*.wav
!tests/drills/paint-drying-clean.wav

# Cloned third-party sources (restored via third_party/install-third-party.sh)
third_party/dpf/
third_party/deepfilternet/
# Downloaded model files (restored via third_party/download-models.sh).
# Models are large binaries and never belong in git.
third_party/models/
# Project-local Rust toolchain (installed by install-third-party.sh).
# Never belongs in git either.
third_party/rust/
# Keep the install/build/download scripts:
!third_party/install-third-party.sh
!third_party/build-libdf.sh
!third_party/download-models.sh
!third_party/README.md

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db
